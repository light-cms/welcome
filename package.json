{
  "name": "neon-mail-bot",
  "description": "Send mail using Neon Functions and Nodemailer to new users.",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "dev": "neon dev",
    "deploy": "neon deploy --env .env.local",
    "endpoint": "neon functions get greet",
    "register:commands": "rm -rf .tmp-register && tsc --outDir .tmp-register --noEmit false && bun run --env-file=.env.local .tmp-register/scripts/registerCommands.js"
  },
  "dependencies": {
    "@neon/config": "^1.10.0",
    "@neon/env": "^1.6.8",
    "@neon/functions": "^0.11.0",
    "drizzle-orm": "^0.45.4",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3"
  }
}
